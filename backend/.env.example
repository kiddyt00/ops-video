# ===========================================
# Ops-Video Backend Environment Configuration
# ===========================================
# Copy this file to .env and update the values

# -------------------------------------------
# Database Configuration
# -------------------------------------------
# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://ops:ops_password@localhost:5432/ops_video

# For development with SQLite (optional)
# DATABASE_URL=sqlite:///./ops_video.db

# -------------------------------------------
# ComfyUI Configuration
# -------------------------------------------
# ComfyUI server host and port
COMFYUI_HOST=localhost
COMFYUI_PORT=8188

# -------------------------------------------
# LLM Configuration (Optional)
# -------------------------------------------
# For local LLM (Ollama, etc.) or API (OpenAI, etc.)
LLM_API_KEY=
LLM_API_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen:7b

# -------------------------------------------
# Storage Configuration
# -------------------------------------------
# Path to store generated files (images, audio, video)
STORAGE_PATH=./storage

# -------------------------------------------
# CORS Configuration
# -------------------------------------------
# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# -------------------------------------------
# Server Configuration
# -------------------------------------------
# Number of uvicorn workers (production)
UVICORN_WORKERS=4

# Server host and port
HOST=0.0.0.0
PORT=8000

# -------------------------------------------
# Redis Configuration (Optional)
# -------------------------------------------
# Redis connection URL for caching
# Format: redis://HOST:PORT/DB
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------
# Logging Configuration
# -------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=./logs

# -------------------------------------------
# Security (Optional)
# -------------------------------------------
# API key for protecting endpoints (optional)
# API_KEY=your-secret-api-key

# JWT secret for authentication (optional)
# JWT_SECRET=your-jwt-secret
